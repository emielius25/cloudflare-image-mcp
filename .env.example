# Amazon affiliate carousel agent - environment variables
#
# Copy to `.env` for local runs. In GitHub Actions these come from repository
# secrets and variables. NEVER commit real values.

# --- Secrets -----------------------------------------------------------------
RAPIDAPI_KEY=            # Axesso Amazon Data Service (RapidAPI)
MANYLINKS_API_KEY=       # ManyLinks, Bearer ml_live_...
CF_API_TOKEN=            # Cloudflare token with Workers AI permission
CF_ACCOUNT_ID=           # Cloudflare account id
LLM_API_KEY=             # OpenAI-compatible key for reasoning / copy / vision

# --- Repo variables / optional tuning ---------------------------------------
AFFILIATE_TAG=bedroomassoci-20
NICHE=bedroom & sleep products
TARGET=tiktok
POSTS_PER_RUN=1

# Optional: OpenAI-compatible endpoint + models for the LLM steps
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini

# Optional: paths (usually not needed)
# FFMPEG_BIN=/usr/bin/ffmpeg
# FONT_PATH=assets/fonts/NotoSans-Bold.ttf
